            /* before */ mstore(   0,r   ) // after
            // prettier-ignore
            /* still ignored */ mstore(0,   s)
        }
    }
}

contract PrettierIgnoreStrings {
    function f() external pure {
        // prettier-ignore
        "a"   "b";
        "c"   "d"  ;
        // prettier-ignore
