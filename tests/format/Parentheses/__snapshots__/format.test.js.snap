// SPDX-License-Identifier: MIT
pragma solidity 0.8.37;

contract BitAndNoParentheses {
    function bitAndAdd(uint256 a, uint256 b, uint256 c)
        public
        pure
        returns (uint256)
    {
        return a & b + c;
    }

    function bitAndSub(uint256 a, uint256 b, uint256 c)
        public
