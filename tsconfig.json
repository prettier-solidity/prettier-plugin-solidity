{
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true,
    "noImplicitAny": true,
    "strictPropertyInitialization": true,
    "sourceMap": true,
    "target": "es2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["./src/**/*", "./variant-coverage/**/*"]
}
